{
  "name": "@toolsplus/json-evolutions",
  "version": "1.0.3",
  "description": "JSON evolutions",
  "type": "module",
  "types": "./build/index.d.ts",
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "import": "./build/index.js"
    }
  },
  "repository": "https://github.com/toolsplus/json-evolutions",
  "author": "Tobias Binna <tobias.binna@toolsplus.io>",
  "license": "MIT",
  "files": [
    "build/*.d.ts",
    "build/*.js",
    "!**/*.spec.*",
    "!**/__fixtures__/**",
    "!**/__mocks__/**",
    "!**/*.json",
    "README.md",
    "docs/migration-v2.md"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prepare": "husky install",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "fix": "run-s fix:*",
    "fix:prettier": "prettier \"src/**/*.ts\" \"test/**/*.ts\" \"scripts/**/*.mjs\" \"vitest.config.ts\" \"README.md\" \"docs/migration-v2.md\" --write",
    "fix:lint": "eslint src test --fix",
    "lint": "eslint src test",
    "prettier": "prettier \"src/**/*.ts\" \"test/**/*.ts\" \"scripts/**/*.mjs\" \"vitest.config.ts\" \"README.md\" \"docs/migration-v2.md\" --check",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "smoke:package": "node scripts/package-smoke.mjs",
    "watch:build": "tsc -p tsconfig.json -w",
    "watch:test": "vitest",
    "doc": "run-s doc:html",
    "doc:html": "typedoc src/index.ts --out build/docs",
    "doc:json": "typedoc src/index.ts --json build/docs/typedoc.json",
    "prepare-release": "run-s build doc:html",
    "semantic-release": "semantic-release"
  },
  "devDependencies": {
    "@commitlint/cli": "17.3.0",
    "@commitlint/config-angular": "17.3.0",
    "@eslint/js": "9.35.0",
    "@semantic-release/commit-analyzer": "13.0.1",
    "@semantic-release/github": "12.0.6",
    "@semantic-release/npm": "13.1.2",
    "@semantic-release/release-notes-generator": "14.1.0",
    "@types/node": "24.12.2",
    "@typescript-eslint/eslint-plugin": "8.43.0",
    "@typescript-eslint/parser": "8.43.0",
    "@vitest/coverage-v8": "4.1.10",
    "effect": "4.0.0-beta.107",
    "eslint": "9.35.0",
    "eslint-config-prettier": "10.1.8",
    "fast-check": "4.9.0",
    "globals": "17.4.0",
    "husky": "^8.0.3",
    "npm-run-all": "4.1.5",
    "prettier": "3.9.6",
    "semantic-release": "25.0.2",
    "typedoc": "0.28.18",
    "typescript": "5.9.2",
    "vitest": "4.1.10"
  },
  "peerDependencies": {
    "effect": "4.0.0-beta.107"
  },
  "dependencies": {
    "fast-json-patch": "^3.1.1",
    "immutability-helper": "^3.1.1"
  }
}
